---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;

const entradas = await getCollection('blog');
entradas.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Layout
  title="Blog"
  description="Entradas sobre matemáticas, sistemas dinámicos y experiencias académicas."
>
  <header class="page-header">
    <h2 class="page-title page-title--blog">Blog</h2>
    <p class="page-subtitle">
      Entradas cortas sobre mis experiencias, reflexiones y notas sobre la organización del conocimiento matemático.
    </p>
  </header>

  {entradas.map(e => (
    <article class="project project--prot">
      <div class="project-header">
        <h3>{e.data.title}</h3>
        <span class="badge-date">
          {e.data.date}
        </span>
      </div>
      <p>{e.data.description}</p>
      {e.data.tags && (
        <div class="project-tags">
          {e.data.tags.map((tag: string) => (
            <span class="project-tag">{tag}</span>
          ))}
        </div>
      )}
      <div class="project-actions">
        <a class="btn btn-warm" href={`${base}/blog/${e.id.replace(/\.mdx?$/, '')}/`}>
          Leer entrada →
        </a>
      </div>
    </article>
  ))}
</Layout>
