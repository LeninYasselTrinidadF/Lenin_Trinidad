---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith('/') ? rawBase.slice(0, -1) : rawBase;

const entradas = await getCollection('blog');
entradas.sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime());
---

<Layout
  title="Blog"
  description="Entradas sobre matemáticas, sistemas dinámicos y experiencias académicas."
>
  <div style="text-align: center; margin-bottom: var(--espacio-lg);">
    <h2 style="background: linear-gradient(135deg, var(--prot-beige), var(--ark-gold)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text;">
      Blog
    </h2>
    <p style="color: var(--text-second); font-size: 0.92rem; max-width: 580px; margin: 0 auto;">
      Entradas cortas sobre mis experiencias, reflexiones y notas sobre la organización del conocimiento matemático.
    </p>
  </div>

  {entradas.map(e => (
    <article class="project" style="border-left-color: var(--prot-orange);">
      <div class="project-header">
        <h3 style="color: var(--prot-beige);">{e.data.title}</h3>
        <span class="badge-date" style="padding: 2px 8px; border-radius: 4px; font-size: 0.78rem; font-weight: 600; white-space: nowrap;">
          {e.data.date}
        </span>
      </div>
      <p>{e.data.description}</p>
      {e.data.tags && (
        <div class="project-tags">
          {e.data.tags.map((tag: string) => (
            <span class="project-tag">{tag}</span>
          ))}
        </div>
      )}
      <div style="margin-top: 10px;">
        <a class="btn btn-warm" href={`${base}/blog/${e.id.replace(/\.mdx?$/, '')}/`}>
          Leer entrada →
        </a>
      </div>
    </article>
  ))}
</Layout>
