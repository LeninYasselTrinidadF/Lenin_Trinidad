---
import Layout from "../layouts/Layout.astro";

const rawBase = import.meta.env.BASE_URL;
const base = rawBase.endsWith("/") ? rawBase.slice(0, -1) : rawBase;
---

<Layout title="Sobre mí">
  <header class="page-header-left">
    <h2 class="page-title page-title--sobre">Sobre mí</h2>
    <p class="page-subtitle-left">
      Egresado de la carrera de Matemática en la Universidad Nacional Mayor de
      San Marcos (UNMSM), interesado en análisis, álgebra y sistemas dinámicos.
    </p>
  </header>

  <div class="sobre-grid">
    <!-- Columna Principal: Experiencia e Intereses -->
    <div class="sobre-block">
      <h2>Experiencia</h2>
      <div class="exp-item">
        <span class="exp-icon">▶</span>
        <span
          ><strong class="exp-title">Asistente de docencia</strong> — sesiones de
          tutoría en álgebra y análisis.</span
        >
      </div>
      <div class="exp-item">
        <span class="exp-icon">▶</span>
        <span
          ><strong class="exp-title">Profesor</strong> de la academia Trinotrix.</span
        >
      </div>
      <div class="exp-item">
        <span class="exp-icon">▶</span>
        <span
          ><strong class="exp-title">Investigación independiente</strong> en sistemas
          dinámicos y análisis funcional.</span
        >
      </div>

      <h3>Intereses académicos</h3>
      <ul>
        <li>Análisis funcional y ecuaciones diferenciales</li>
        <li>Álgebra abstracta y teoría de grupos</li>
        <li>Sistemas dinámicos y teoría del caos</li>
        <li>Matemática aplicada a ciencias de la computación</li>
      </ul>
    </div>

    <!-- Columna Lateral: Contacto y Fotografía -->
    <div class="sobre-sidebar">
      <div class="contact-block">
        <h3>Contacto</h3>
        <div class="contact-label">Teléfono:</div>
        <a class="contact-link" href="tel:+51951453715">+51 951 453 715</a>

        <div class="contact-label">Correo:</div>
        <a class="contact-link" href="mailto:lenin.yasel@gmail.com"
          >✉ lenin.yasel@gmail.com</a
        >
        <a class="contact-link" href="mailto:lenin.trinidad@unmsm.edu.pe"
          >✉ lenin.trinidad@unmsm.edu.pe</a
        >
        <a class="contact-link" href="mailto:lenin.trinidad.f@uni.pe"
          >✉ lenin.trinidad.f@uni.pe</a
        >

        <div class="contact-label">GitHub:</div>
        <a
          class="contact-link"
          href="https://github.com/leninyasseltrinidadf"
          target="_blank"
          rel="noopener"
        >
          github.com/leninyasseltrinidadf
        </a>

        <div class="contact-label">Página:</div>
        <a
          class="contact-link"
          href="https://leninyasseltrinidadf.github.io/Lenin_Trinidad"
          target="_blank"
          rel="noopener"
        >
          leninyasseltrinidadf.github.io
        </a>
      </div>

      <div class="sobre-imagen">
        <img
          src={`${base}/imagenes/Lenin_Trinidad.jpg`}
          alt="Foto de Lenin Trinidad"
        />
        <p class="pie-foto">Estudiante de Matemática — UNMSM</p>
      </div>
    </div>
  </div>
</Layout>
