---
import Layout from "../../layouts/Layout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const entradas = await getCollection("blog");
  return entradas.map((entry) => ({
    params: { slug: entry.id.replace(/\.mdx?$/, "") },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<Layout title={entry.data.title} description={entry.data.description}>
  <article class="project" style="border-left-color: var(--prot-orange); padding: 24px;">
    <h2 style="font-size: 1.4rem; background: linear-gradient(135deg, var(--prot-beige), var(--ark-gold)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; margin-bottom: 8px;">
      {entry.data.title}
    </h2>
    <div style="display: flex; align-items: center; gap: 10px; margin-bottom: 1.2rem; flex-wrap: wrap;">
      <span class="badge-date" style="padding: 2px 8px; border-radius: 4px; font-size: 0.78rem; font-weight: 600;">
        {entry.data.date}
      </span>
      {
        entry.data.tags && (
          <div class="project-tags" style="margin-bottom: 0;">
            {entry.data.tags.map((tag) => (
              <span class="project-tag">{tag}</span>
            ))}
          </div>
        )
      }
    </div>

    <div class="blog-content">
      <Content />
    </div>
  </article>
</Layout>

<!-- KaTeX -->
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css"
/>
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"
></script>
<script
  defer
  src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"
></script>
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    if (window.renderMathInElement) {
      renderMathInElement(document.body, {
        delimiters: [
          { left: "$$", right: "$$", display: true },
          { left: "$", right: "$", display: false },
        ],
        throwOnError: false,
      });
    }
  });
</script>

<style>
  .blog-content {
    color: var(--text-second);
    font-size: 0.95rem;
  }
  .blog-content p {
    margin-bottom: 1.2rem;
    line-height: 1.8;
  }
  .blog-content a {
    color: var(--nitori-blue);
    text-decoration: none;
  }
  .blog-content a:hover {
    color: var(--cirno-ice);
    text-decoration: underline;
  }
  .blog-content strong {
    color: var(--text-main);
  }
  .blog-content em {
    color: var(--cirno-ice);
    font-style: italic;
  }
  .blog-content code {
    background: rgba(43, 70, 97, 0.45);
    border: 1px solid var(--card-border);
    color: var(--thales-bright);
    padding: 0.15rem 0.4rem;
    border-radius: 4px;
    font-size: 0.88em;
    font-family: monospace;
  }
</style>
